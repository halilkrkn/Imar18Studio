<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Imar18.Presentation.Avalonia.Controls"
        xmlns:g="clr-namespace:Imar18.Presentation.Avalonia.Gorunum"
        x:Class="Imar18.Presentation.Avalonia.Views.MainWindow"
        Title="Imar18Studio — PİLOT (Resmî işlemde kullanılamaz)"
        Width="1440" Height="900" MinWidth="1024" MinHeight="640"
        Background="{DynamicResource CadBg}">
  <!--
    P7 UI revizyonu (UI_UX_Referans_v2_19.html) + P7 saha/UI cilası: Imar18Studio amblemi, Ctrl+K komut çubuğu (tıklama / çift
    tıklama / Enter ile çalışır; Esc veya dışarı tıklama kapatır), ayrı Koyu/Açık Stüdyo ve Koyu/Açık Pafta anahtarları,
    numaralı profesyonel stepper, Projeyi Temizle / Sıfırla, alan bazlı kırmızı hata çerçevesi + alt hata satırı, Zorunlu /
    İsteğe bağlı rozetleri, seçilebilir ve kopyalanabilir uyarı/hata/özet metinleri, canlı Katman → Rol eşlemesi, OSNAP
    yakalama geri bildirimi ve yalnız hesabı etkileyen uyarıları sayan Uyarı & Denetim sekmesi.
  -->
  <Window.Resources>
    <DataTemplate x:Key="TurkceAdSablonu">
      <TextBlock Text="{Binding Converter={x:Static g:TurkceAdConverter.Ornek}}" />
    </DataTemplate>
    <DataTemplate x:Key="MeridyenSablonu">
      <TextBlock Text="{Binding Converter={x:Static g:TurkceAdConverter.Ornek}, ConverterParameter=meridyen}" />
    </DataTemplate>

    <!-- Seçilebilir + kopyalanabilir satırlar: metin seçilebilir (Ctrl+C), "⧉" tek tık ve sağ tık "Kopyala". -->
    <DataTemplate x:Key="UyariSablonu">
      <Grid ColumnDefinitions="*,Auto" Margin="0,1">
        <SelectableTextBlock Text="{Binding}" Classes="ozet">
          <SelectableTextBlock.ContextMenu>
            <ContextMenu>
              <MenuItem Header="📋 Kopyala" Tag="{Binding}" Click="OnKopyalaClick" />
            </ContextMenu>
          </SelectableTextBlock.ContextMenu>
        </SelectableTextBlock>
        <Button Grid.Column="1" Classes="kopyala" Content="⧉" Tag="{Binding}" Click="OnKopyalaClick" ToolTip.Tip="Panoya kopyala" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="HataSablonu">
      <Grid ColumnDefinitions="*,Auto" Margin="0,1">
        <SelectableTextBlock Text="{Binding}" Classes="hata">
          <SelectableTextBlock.ContextMenu>
            <ContextMenu>
              <MenuItem Header="📋 Kopyala" Tag="{Binding}" Click="OnKopyalaClick" />
            </ContextMenu>
          </SelectableTextBlock.ContextMenu>
        </SelectableTextBlock>
        <Button Grid.Column="1" Classes="kopyala" Content="⧉" Tag="{Binding}" Click="OnKopyalaClick" ToolTip.Tip="Panoya kopyala" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="BilgiSablonu">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
        <TextBlock Text="ℹ️" FontSize="11" Margin="0,0,6,0" />
        <SelectableTextBlock Grid.Column="1" Text="{Binding}" Classes="aciklama">
          <SelectableTextBlock.ContextMenu>
            <ContextMenu>
              <MenuItem Header="📋 Kopyala" Tag="{Binding}" Click="OnKopyalaClick" />
            </ContextMenu>
          </SelectableTextBlock.ContextMenu>
        </SelectableTextBlock>
        <Button Grid.Column="2" Classes="kopyala" Content="⧉" Tag="{Binding}" Click="OnKopyalaClick" ToolTip.Tip="Panoya kopyala" />
      </Grid>
    </DataTemplate>
    <!-- Özet değerleri (ContentControl ile tek metin) -->
    <DataTemplate x:Key="OzetSablonu">
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <SelectableTextBlock Text="{Binding}" Classes="ozet">
          <SelectableTextBlock.ContextMenu>
            <ContextMenu>
              <MenuItem Header="📋 Kopyala" Tag="{Binding}" Click="OnKopyalaClick" />
            </ContextMenu>
          </SelectableTextBlock.ContextMenu>
        </SelectableTextBlock>
        <Button Grid.Column="1" Classes="kopyala" Content="⧉" Tag="{Binding}" Click="OnKopyalaClick" ToolTip.Tip="Panoya kopyala" />
      </Grid>
    </DataTemplate>
    <!-- Doğrulama sonucu satırı: ikon + metin (uyarı amber, hata kırmızı) -->
    <DataTemplate x:Key="DogrulamaSablonu">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
        <Panel Margin="0,0,6,0">
          <TextBlock Text="⚠️" FontSize="11" IsVisible="{Binding Converter={x:Static g:Ceviriciler.UyariMi}}" />
          <TextBlock Text="⛔" FontSize="11" IsVisible="{Binding Converter={x:Static g:Ceviriciler.HataMi}}" />
        </Panel>
        <Panel Grid.Column="1">
          <SelectableTextBlock Text="{Binding}" Classes="ozet" IsVisible="{Binding Converter={x:Static g:Ceviriciler.UyariMi}}" />
          <SelectableTextBlock Text="{Binding}" Classes="hata" IsVisible="{Binding Converter={x:Static g:Ceviriciler.HataMi}}" />
        </Panel>
        <Button Grid.Column="2" Classes="kopyala" Content="⧉" Tag="{Binding}" Click="OnKopyalaClick" ToolTip.Tip="Panoya kopyala" />
      </Grid>
    </DataTemplate>
    <!-- SAHA-004 topoloji notu: seviye ikonu + Türkçe parsel / alan ayrıntısı -->
    <DataTemplate x:Key="TopolojiSablonu">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
        <TextBlock Text="{Binding Seviye, Converter={x:Static g:Ceviriciler.SeviyeIkonu}}" FontSize="11" Margin="0,0,6,0" />
        <SelectableTextBlock Grid.Column="1" Text="{Binding Metin}" Classes="ozet">
          <SelectableTextBlock.ContextMenu>
            <ContextMenu>
              <MenuItem Header="📋 Kopyala" Tag="{Binding Metin}" Click="OnKopyalaClick" />
            </ContextMenu>
          </SelectableTextBlock.ContextMenu>
        </SelectableTextBlock>
        <Button Grid.Column="2" Classes="kopyala" Content="⧉" Tag="{Binding Metin}" Click="OnKopyalaClick" ToolTip.Tip="Panoya kopyala" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <!--
    Responsive yerlesim: kod arkasi pencere genisligine gore "dar" (< 1680 px) ve "kompakt" (< 1280 px) siniflarini atar.
    Kompakt modda ikincil etiketler (sinif "genis") gizlenir, stepper yalniz aktif adimin adini gosterir; yan paneller
    1200 px altinda en kucuk genislige iner (OnSizeChanged).
  -->
  <Window.Styles>
    <Style Selector=":is(Window).kompakt :is(Control).genis">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=":is(Window).dar :is(Control).genisDar">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TextBlock.darOnly">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=":is(Window).dar TextBlock.darOnly">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector=":is(Window).kompakt Button.adim TextBlock.adimAdi">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=":is(Window).kompakt Button.adim.aktif TextBlock.adimAdi">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector=":is(Window).dar Button#AramaCubugu">
      <Setter Property="Margin" Value="10,0" />
    </Style>
    <Style Selector=":is(Window).dar Border.adimBag">
      <Setter Property="Width" Value="24" />
    </Style>
    <Style Selector=":is(Window).kompakt Border.adimBag">
      <Setter Property="Width" Value="16" />
    </Style>
  </Window.Styles>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+K" Command="{Binding TogglePaletteCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding RequestOpenFileCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding FitAllCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding EscCommand}" />
  </Window.KeyBindings>

  <Grid x:Name="KokIzgara" RowDefinitions="Auto,Auto,*,Auto,210,Auto">

    <!-- ===================== ÜST BAŞLIK: amblem, Ctrl+K arama, temizle, panel ve stüdyo tema anahtarları ===================== -->
    <Border Grid.Row="0" Classes="panel" BorderThickness="0,0,0,1" Padding="14,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image x:Name="Logo" Source="{StaticResource Imar18Logo}" Width="30" Height="30" ToolTip.Tip="Imar18Studio — 3194 Md. 18 arazi ve arsa düzenleme stüdyosu" />
          <StackPanel VerticalAlignment="Center" Spacing="0">
            <TextBlock x:Name="MarkaAdi" Text="Imar18Studio" Classes="marka" />
            <TextBlock Text="Md. 18 Düzenleme Stüdyosu" Classes="aciklama genisDar" FontSize="10" />
          </StackPanel>
          <Border Classes="rozet amber" Margin="6,0,0,0" ToolTip.Tip="EVRE 1: PİLOT · Sentetik Veri · Taslak — resmî işlemde kullanılamaz">
            <Panel>
              <TextBlock Text="EVRE 1: PİLOT · Sentetik Veri · Taslak" Classes="genisDar" FontSize="11" Foreground="{DynamicResource CadAmber}" />
              <TextBlock Text="PİLOT" Classes="darOnly" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CadAmber}" />
            </Panel>
          </Border>
        </StackPanel>

        <Button x:Name="AramaCubugu" Grid.Column="1" Classes="arama" Margin="20,0" MaxWidth="560" HorizontalAlignment="Stretch"
                Command="{Binding TogglePaletteCommand}" ToolTip.Tip="Kural tabanlı Türkçe komut çubuğu (yapay zekâ içermez)">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="🔍  Komut veya işlem ara… (sığdır, kadastro, pafta, onay, cetvel, temizle)" Classes="aciklama" FontSize="12"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <Border Grid.Column="1" Classes="rozet" Padding="6,1">
              <TextBlock Text="Ctrl+K" Classes="mono" Foreground="{DynamicResource CadMuted}" />
            </Border>
          </Grid>
        </Button>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="ust" Command="{Binding RequestOpenFileCommand}" ToolTip.Tip="CAD dosyası aç (Ctrl+O)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="📂" />
              <TextBlock Text="CAD Aç" Classes="genis" />
            </StackPanel>
          </Button>
          <!-- Tek "Projeyi Temizle" dugmesi: onay penceresindeki dugme komutu kod arkasinda calistirir (acilir pencere kapaninca
               baglama DataContext'ini kaybettigi icin Command baglamasi calismiyordu). -->
          <Button x:Name="UstTemizleDugmesi" Classes="ust temizle" ToolTip.Tip="Projeyi Temizle / Sıfırla — harita, tablolar ve girdiler temizlenir">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="🧹" />
              <TextBlock Text="Projeyi Temizle" Classes="genis" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="290" Spacing="10">
                  <TextBlock Text="🧹 Projeyi Temizle / Sıfırla" Classes="baslik" />
                  <TextBlock Text="Harita, tablolar ve tüm girdiler temizlenir; tuval ızgaralı boş paftaya döner. İşlem denetime yazılır, mevcut onay düşer."
                             Classes="aciklama" />
                  <Grid ColumnDefinitions="*,8,*">
                    <Button Content="Vazgeç" Click="OnTemizleVazgecClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button x:Name="TemizleOnayDugmesi" Grid.Column="2" Content="Evet, temizle" Click="OnTemizleOnayClick"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="Danger" Theme="{DynamicResource SolidButton}" />
                  </Grid>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Border Width="1" Height="20" Background="{DynamicResource CadBorder}" Margin="2,0" />
          <ToggleButton x:Name="SolPanelAnahtari" Classes="ust" IsChecked="{Binding SolPanelAcik, Mode=OneWay}" Command="{Binding SolPanelDegistirCommand}" ToolTip.Tip="Sol sihirbaz panelini aç/kapat">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="◧" />
              <TextBlock Text="Sihirbaz" Classes="genis" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="ust" IsChecked="{Binding AltPanelAcik, Mode=OneWay}" Command="{Binding AltPanelDegistirCommand}" ToolTip.Tip="Alt canlı cetvel panelini aç/kapat">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="⬓" />
              <TextBlock Text="Cetvel" Classes="genis" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="ust" IsChecked="{Binding SagPanelAcik, Mode=OneWay}" Command="{Binding SagPanelDegistirCommand}" ToolTip.Tip="Sağ parsel denetçisini aç/kapat">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="◨" />
              <TextBlock Text="Denetçi" Classes="genis" />
            </StackPanel>
          </ToggleButton>
          <Button x:Name="TemaAnahtari" Classes="ust" Content="{Binding TemaEtiketi}" Command="{Binding TemaDegistirCommand}"
                  ToolTip.Tip="Stüdyo teması: tüm pencere, paneller ve kartlar (pafta da eşlenir; tuvaldeki pafta anahtarıyla ayrıca değiştirilebilir)" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== SİHİRBAZ STEPPER + revizyon / onay rozetleri ===================== -->
    <Border Grid.Row="1" Background="{DynamicResource CadNav}" BorderBrush="{DynamicResource CadBorder}" BorderThickness="0,0,0,1" Padding="14,7">
      <Grid ColumnDefinitions="*,Auto">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="AdimCubugu" ItemsSource="{Binding Wizard.AdimOgeleri}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Border Classes="adimBag" Classes.tamam="{Binding BagTamam}" IsVisible="{Binding BaglantiVar}" />
                  <Button Classes="adim" Classes.aktif="{Binding IsActive}" Classes.tamam="{Binding IsTamam}"
                          Command="{Binding $parent[ItemsControl].DataContext.Wizard.AdimaGitCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="{Binding Baslik, StringFormat='{}{0} — adıma git (ileri adımlar için 1. adım girdileri doğrulanmalı)'}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Classes="adimRozet" Classes.aktif="{Binding IsActive}" Classes.tamam="{Binding IsTamam}">
                        <TextBlock Text="{Binding RozetMetni}" />
                      </Border>
                      <TextBlock Text="{Binding Ad}" Classes="adimAdi" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
          <Panel IsVisible="{Binding OnayCikti, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Orientation="Horizontal" Spacing="6" DataContext="{Binding OnayCikti}">
              <Border Classes="rozet" ToolTip.Tip="{Binding RevizyonTam, StringFormat='Hesap revizyonu (RevisionId): {0}'}">
                <TextBlock x:Name="RevizyonRozeti" Text="{Binding RevizyonKisa, StringFormat='🔖 Rev: {0}'}" Classes="mono" />
              </Border>
              <Button Classes="arac" Content="⧉" Command="{Binding RevizyonuKopyalaCommand}" ToolTip.Tip="Revizyon kimliğini panoya kopyala" />
              <Border Classes="rozet amber" Classes.yesil="{Binding GecerliOnayVar}">
                <TextBlock Text="{Binding OnayDurumu}" FontSize="11" FontWeight="SemiBold" />
              </Border>
            </StackPanel>
          </Panel>
          <Border Classes="rozet" IsVisible="{Binding OnayCikti, Converter={x:Static ObjectConverters.IsNull}}">
            <TextBlock Text="Proje çalışma alanı yok" Classes="aciklama" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== ANA ÇALIŞMA ALANI: sol | bölme | tuval | bölme | sağ ===================== -->
    <Grid x:Name="AnaIzgara" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="310" MinWidth="240" MaxWidth="560" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="320" MinWidth="250" MaxWidth="560" />
      </Grid.ColumnDefinitions>

      <!-- ===================== SOL: SİHİRBAZ ===================== -->
      <Border x:Name="SolPanel" Grid.Column="0" Classes="panel" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Margin="14,12,14,8" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Text="🧭 SİHİRBAZ" Classes="bolum" />
            <Border Grid.Column="1" Classes="rozet" Padding="7,1">
              <TextBlock x:Name="AdimSayaci" Text="{Binding Wizard.AdimSayaci}" Classes="mono" FontSize="10" Foreground="{DynamicResource CadMuted}" />
            </Border>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Wizard.CurrentStepTitle}" Classes="baslik" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
          </Grid>

          <ScrollViewer x:Name="SihirbazKaydirma" Grid.Row="1" Padding="12,4,16,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Margin="0,0,0,28">

              <!-- 1. Girdi & Sınır -->
              <StackPanel Spacing="10" IsVisible="{Binding Wizard.IsStep1}">
                <Border Classes="kart">
                  <StackPanel Spacing="6">
                    <Border Classes="kartBaslik"><TextBlock Text="📂 CAD GİRDİSİ" Classes="bolum" /></Border>
                    <Button Content="📂 CAD Dosyası Aç (Ctrl+O)" Command="{Binding RequestOpenFileCommand}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Classes="Primary" Theme="{DynamicResource SolidButton}" />
                    <TextBlock Text="Birincil: .NCZ (Netcad) · Yedek: .DXF / .DWG (AutoCAD)" Classes="aciklama" />
                  </StackPanel>
                </Border>

                <Border Classes="kart" Padding="4">
                  <Expander Classes="bolum" IsExpanded="True" Header="🌐 Proje CRS / Dilim / Ölçek (D3)">
                    <StackPanel Spacing="0">
                      <StackPanel Classes="alanBaslik">
                        <TextBlock Text="Geodetik datum" Classes="etiket" />
                        <Border Classes="zorunlu"><TextBlock Text="Zorunlu" /></Border>
                      </StackPanel>
                      <ComboBox ItemsSource="{Binding Wizard.Datumlar}" SelectedItem="{Binding Wizard.Datum}"
                                ItemTemplate="{StaticResource TurkceAdSablonu}" HorizontalAlignment="Stretch" />
                      <StackPanel Classes="alanBaslik">
                        <TextBlock Text="Dilim orta meridyeni (DOM)" Classes="etiket" />
                        <Border Classes="zorunlu"><TextBlock Text="Zorunlu" /></Border>
                      </StackPanel>
                      <ComboBox ItemsSource="{Binding Wizard.OrtaMeridyenler}" SelectedItem="{Binding Wizard.OrtaMeridyen}"
                                ItemTemplate="{StaticResource MeridyenSablonu}" HorizontalAlignment="Stretch"
                                Classes.hatali="{Binding Wizard.CrsHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <Grid Classes="alanHatasi" ColumnDefinitions="Auto,*" IsVisible="{Binding Wizard.CrsHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
<TextBlock Text="⛔" FontSize="10" Margin="0,1,5,0" />
<SelectableTextBlock Grid.Column="1" Text="{Binding Wizard.CrsHatasi}" Classes="hata" />
</Grid>
                      <StackPanel Classes="alanBaslik">
                        <TextBlock Text="Epok (ITRF96 için 2005.00)" Classes="etiket" />
                        <Border Classes="zorunlu"><TextBlock Text="Zorunlu" /></Border>
                      </StackPanel>
                      <TextBox x:Name="EpokKutusu" Text="{Binding Wizard.EpokText}" Watermark="2005.00"
                               Classes.hatali="{Binding Wizard.EpokHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <Grid x:Name="EpokHataSatiri" Classes="alanHatasi" ColumnDefinitions="Auto,*" IsVisible="{Binding Wizard.EpokHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
<TextBlock Text="⛔" FontSize="10" Margin="0,1,5,0" />
<SelectableTextBlock Grid.Column="1" Text="{Binding Wizard.EpokHatasi}" Classes="hata" />
</Grid>
                      <StackPanel Classes="alanBaslik">
                        <TextBlock Text="Pafta ölçeği paydası (1/M)" Classes="etiket" />
                        <Border Classes="zorunlu"><TextBlock Text="Zorunlu" /></Border>
                      </StackPanel>
                      <TextBox Text="{Binding Wizard.OlcekPaydasi}" Watermark="1000"
                               Classes.hatali="{Binding Wizard.OlcekHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <Grid Classes="alanHatasi" ColumnDefinitions="Auto,*" IsVisible="{Binding Wizard.OlcekHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
<TextBlock Text="⛔" FontSize="10" Margin="0,1,5,0" />
<SelectableTextBlock Grid.Column="1" Text="{Binding Wizard.OlcekHatasi}" Classes="hata" />
</Grid>
                    </StackPanel>
                  </Expander>
                </Border>

                <Border Classes="kart" Padding="4">
                  <Expander Classes="bolum" IsExpanded="True" Header="📏 Tecviz Girdisi">
                    <StackPanel Spacing="0">
                      <TextBlock Text="Mühendis girdisi · RG 27.09.2022/31966 (formülle hesaplanmaz)" Classes="aciklama" />
                      <StackPanel Classes="alanBaslik">
                        <TextBlock Text="Ölçek paydası" Classes="etiket" />
                        <Border Classes="zorunlu"><TextBlock Text="Zorunlu" /></Border>
                      </StackPanel>
                      <TextBox Text="{Binding Wizard.TecvizOlcekPaydasi}" Watermark="1000"
                               Classes.hatali="{Binding Wizard.TecvizOlcekHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <Grid Classes="alanHatasi" ColumnDefinitions="Auto,*" IsVisible="{Binding Wizard.TecvizOlcekHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
<TextBlock Text="⛔" FontSize="10" Margin="0,1,5,0" />
<SelectableTextBlock Grid.Column="1" Text="{Binding Wizard.TecvizOlcekHatasi}" Classes="hata" />
</Grid>
                      <StackPanel Classes="alanBaslik">
                        <TextBlock Text="Üretim yöntemi" Classes="etiket" />
                        <Border Classes="zorunlu"><TextBlock Text="Zorunlu" /></Border>
                      </StackPanel>
                      <TextBox x:Name="UretimYontemiKutusu" Text="{Binding Wizard.TecvizUretimYontemi}" Watermark="ör. Sayısallaştırma"
                               Classes.hatali="{Binding Wizard.TecvizUretimYontemiHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <Grid x:Name="UretimYontemiHataSatiri" Classes="alanHatasi" ColumnDefinitions="Auto,*" IsVisible="{Binding Wizard.TecvizUretimYontemiHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
<TextBlock Text="⛔" FontSize="10" Margin="0,1,5,0" />
<SelectableTextBlock Grid.Column="1" Text="{Binding Wizard.TecvizUretimYontemiHatasi}" Classes="hata" />
</Grid>
                      <StackPanel Classes="alanBaslik">
                        <TextBlock Text="Koordinat kalitesi" Classes="etiket" />
                        <Border Classes="zorunlu"><TextBlock Text="Zorunlu" /></Border>
                      </StackPanel>
                      <ComboBox ItemsSource="{Binding Wizard.Kaliteler}" SelectedItem="{Binding Wizard.TecvizKoordinatKalitesi}"
                                ItemTemplate="{StaticResource TurkceAdSablonu}" HorizontalAlignment="Stretch" />
                      <StackPanel Classes="alanBaslik">
                        <TextBlock Text="Tecviz sınırı (m²)" Classes="etiket" />
                        <Border Classes="zorunlu"><TextBlock Text="Zorunlu" /></Border>
                      </StackPanel>
                      <TextBox x:Name="TecvizSiniriKutusu" Text="{Binding Wizard.TecvizSiniriText}" Watermark="ör. 3.97"
                               Classes.hatali="{Binding Wizard.TecvizSiniriHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <Grid Classes="alanHatasi" ColumnDefinitions="Auto,*" IsVisible="{Binding Wizard.TecvizSiniriHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
<TextBlock Text="⛔" FontSize="10" Margin="0,1,5,0" />
<SelectableTextBlock Grid.Column="1" Text="{Binding Wizard.TecvizSiniriHatasi}" Classes="hata" />
</Grid>
                      <StackPanel Classes="alanBaslik">
                        <TextBlock Text="Kaynak notu" Classes="etiket" />
                        <Border Classes="zorunlu"><TextBlock Text="Zorunlu" /></Border>
                      </StackPanel>
                      <TextBox Text="{Binding Wizard.TecvizKaynakNotu}" Watermark="TKGM / Netcad dengeleme raporu"
                               Classes.hatali="{Binding Wizard.TecvizKaynakNotuHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <Grid Classes="alanHatasi" ColumnDefinitions="Auto,*" IsVisible="{Binding Wizard.TecvizKaynakNotuHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
<TextBlock Text="⛔" FontSize="10" Margin="0,1,5,0" />
<SelectableTextBlock Grid.Column="1" Text="{Binding Wizard.TecvizKaynakNotuHatasi}" Classes="hata" />
</Grid>
                    </StackPanel>
                  </Expander>
                </Border>

                <Border Classes="kart" Padding="4">
                  <Expander Classes="bolum" IsExpanded="True"
                            Header="{Binding Wizard.LayerRoles.Count, StringFormat='🧩 Katman → Rol Eşlemesi ({0})'}">
                    <StackPanel Spacing="4">
                      <StackPanel Classes="alanBaslik">
                        <TextBlock Text="En az bir kadastro ve bir imar katmanı" Classes="etiket" />
                        <Border Classes="zorunlu"><TextBlock Text="Zorunlu" /></Border>
                      </StackPanel>
                      <TextBlock Text="Standart Netcad katman adları otomatik eşlendi. Rol değişikliği anında uygulanır: tuval renkleri, Parseller tablosu ve proje geometrisi güncellenir." Classes="aciklama" />
                      <TextBlock Text="Henüz CAD dosyası açılmadı." Classes="aciklama"
                                 IsVisible="{Binding Wizard.LayerRoles.Count, Converter={x:Static g:Ceviriciler.Sifir}}" />
                      <!-- P7.3-A (SAHA-005): tuvalden rol atama — çipi seç, tuvalde katmana tıkla (açık çizgiler dahil); Esc çıkar. -->
                      <StackPanel x:Name="RolAtamaSeridi" Spacing="4" Margin="0,2,0,2"
                                  IsVisible="{Binding Wizard.LayerRoles.Count, Converter={x:Static g:Ceviriciler.Pozitif}}">
                        <TextBlock Text="🎯 Tuvalden ata: bir rol çipi seçin, sonra tuvalde katmanın çizgisine tıklayın (Esc: çık). Sağ tık → “Bu Katmanın Rolü ▸”."
                                   Classes="aciklama" TextWrapping="Wrap" />
                        <ItemsControl x:Name="RolCipListesi" ItemsSource="{Binding Canvas.RolCipleri}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <ToggleButton Classes="osnap rolCipi" Margin="0,0,4,4" IsChecked="{Binding Secili, Mode=TwoWay}"
                                            Command="{Binding SecCommand}" ToolTip.Tip="{Binding Ad, StringFormat='Tuvalde tıklanan katmanı “{0}” rolüne ata'}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                  <Ellipse Width="8" Height="8" Fill="{Binding Rol, Converter={x:Static g:Ceviriciler.RolFircasi}}" VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding Ad}" />
                                </StackPanel>
                              </ToggleButton>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <ItemsControl x:Name="KatmanRolListesi" ItemsSource="{Binding Wizard.LayerRoles}">
                        <ItemsControl.Styles>
                          <Style Selector="Border.katmanSatiri">
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                          </Style>
                          <Style Selector="Border.katmanSatiri.vurgulu">
                            <Setter Property="Background" Value="{DynamicResource CadAccentSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CadAccent}" />
                          </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="katmanSatiri" Classes.vurgulu="{Binding Vurgulu}" Margin="0,1">
                              <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                  <Ellipse Width="9" Height="9" Fill="{Binding Role, Converter={x:Static g:Ceviriciler.RolFircasi}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                  <TextBlock Grid.Column="1" Text="{Binding LayerName}" Classes="mono" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                  <Button Grid.Column="2" Content="🎯" Classes="arac" Padding="5,1" MinHeight="22" Command="{Binding VurgulaCommand}"
                                          AutomationProperties.Name="{Binding LayerName, StringFormat='{}{0} katmanını tuvalde vurgula'}"
                                          ToolTip.Tip="Bu katmanı tuvalde vurgula / vurguyu kaldır" />
                                </Grid>
                                <!-- Rol listesi satırın kendi DataContext'inden gelir: $parent bağlaması geç çözülünce SelectedItem kayboluyordu (P7). -->
                                <ComboBox ItemsSource="{Binding Roller}" SelectedItem="{Binding Role}"
                                          ItemTemplate="{StaticResource TurkceAdSablonu}" HorizontalAlignment="Stretch" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Grid Classes="alanHatasi" ColumnDefinitions="Auto,*" IsVisible="{Binding Wizard.KatmanRolHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
<TextBlock Text="⛔" FontSize="10" Margin="0,1,5,0" />
<SelectableTextBlock Grid.Column="1" Text="{Binding Wizard.KatmanRolHatasi}" Classes="hata" />
</Grid>
                      <Button x:Name="EslemeUygulaDugmesi" Content="⟳ Eşlemeyi Uygula" Command="{Binding EslemeyiUygulaCommand}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,0"
                              ToolTip.Tip="Katman → rol eşlemesini tuvale, Parseller tablosuna ve projeye yeniden uygula" />
                    </StackPanel>
                  </Expander>
                </Border>

                <!-- Doğrulama sonucu: başarı (yeşil) veya hata/uyarı (rozetli, ikonlu) kartı -->
                <Border x:Name="DogrulamaBasariKarti" Classes="kart basari" IsVisible="{Binding Wizard.DogrulamaBasarili}">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="✅" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="Girdiler doğrulandı" FontWeight="SemiBold" Foreground="{DynamicResource CadEmerald}" />
                      <TextBlock Text="{Binding Wizard.DogrulamaOzeti, StringFormat='{}{0} · 2. adıma (Tecviz) geçebilirsiniz.'}" Classes="aciklama" />
                      <ItemsControl ItemsSource="{Binding Wizard.Errors}" ItemTemplate="{StaticResource DogrulamaSablonu}" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border x:Name="DogrulamaSonucKarti" Classes="kart hata" IsVisible="{Binding Wizard.HataSayisi, Converter={x:Static g:Ceviriciler.Pozitif}}">
                  <StackPanel Spacing="6">
                    <StackPanel Spacing="6">
                      <TextBlock Text="⛔ DOĞRULAMA" Classes="bolum" Foreground="{DynamicResource CadRose}" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="Doğrulama sonucu" />
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border Classes="rozet kirmizi" Padding="6,1">
                          <TextBlock x:Name="HataRozeti" Text="{Binding Wizard.HataSayisi, StringFormat='{}{0} hata'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource CadRose}" />
                        </Border>
                        <Border Classes="rozet amber" Padding="6,1" IsVisible="{Binding Wizard.UyariSayisi, Converter={x:Static g:Ceviriciler.Pozitif}}">
                          <TextBlock Text="{Binding Wizard.UyariSayisi, StringFormat='{}{0} uyarı'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource CadAmber}" />
                        </Border>
                      </StackPanel>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Wizard.Errors}" ItemTemplate="{StaticResource DogrulamaSablonu}" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- 2. Tecviz — parsel bazlı tapu alanı (mühendis girdisi), hesap alanı Decimal Gauss -->
              <Panel IsVisible="{Binding Wizard.IsStep2}">
                <StackPanel Spacing="10" DataContext="{Binding Hesap}" IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">
                  <Border Classes="kart">
                    <StackPanel Spacing="4">
                      <Border Classes="kartBaslik"><TextBlock Text="📐 PARSEL BAZLI TAPU ALANI" Classes="bolum" /></Border>
                      <TextBlock Text="Hesap alanı Decimal Gauss ile bulunur; tapu alanını mühendis girer." Classes="aciklama" />
                      <Grid ColumnDefinitions="*,84,100" Margin="0,6,0,2">
                        <TextBlock Text="Kadastro parseli" Classes="etiket" />
                        <TextBlock Grid.Column="1" Text="Hesap (m²)" Classes="etiket" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3">
                          <TextBlock Text="Tapu (m²)" Classes="etiket" />
                          <Border Classes="zorunlu"><TextBlock Text="Zorunlu" /></Border>
                        </StackPanel>
                      </Grid>
                      <ItemsControl ItemsSource="{Binding TecvizSatirlari}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="0,2">
                              <Grid ColumnDefinitions="*,84,100">
                                <SelectableTextBlock Text="{Binding ParselId}" Classes="mono" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <SelectableTextBlock Grid.Column="1" Text="{Binding HesapAlaniM2, Converter={x:Static g:Ceviriciler.Sayi}, ConverterParameter=0.00}" Classes="mono"
                                                     Foreground="{DynamicResource CadMuted}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="2" Text="{Binding TapuAlaniText}" Watermark="tapu m²"
                                         Classes.hatali="{Binding Hata, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                              </Grid>
                              <Grid Classes="alanHatasi" ColumnDefinitions="Auto,*" HorizontalAlignment="Right" IsVisible="{Binding Hata, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
<TextBlock Text="⛔" FontSize="10" Margin="0,1,5,0" />
<SelectableTextBlock Grid.Column="1" Text="{Binding Hata}" Classes="hata" />
</Grid>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <Border Classes="kart">
                    <StackPanel Spacing="0">
                      <StackPanel Classes="alanBaslik">
                        <TextBlock Text="Düzenleme toplam tecviz sınırı (m²)" Classes="etiket" />
                        <Border Classes="istege"><TextBlock Text="İsteğe bağlı" /></Border>
                      </StackPanel>
                      <TextBox Text="{Binding ToplamTecvizSiniriText}" Watermark="boş bırakılabilir"
                               Classes.hatali="{Binding ToplamTecvizSiniriHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <Grid Classes="alanHatasi" ColumnDefinitions="Auto,*" IsVisible="{Binding ToplamTecvizSiniriHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
<TextBlock Text="⛔" FontSize="10" Margin="0,1,5,0" />
<SelectableTextBlock Grid.Column="1" Text="{Binding ToplamTecvizSiniriHatasi}" Classes="hata" />
</Grid>
                      <Button Content="Tecvizi Uygula" Command="{Binding TecvizUygulaCommand}" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center" Margin="0,8,0,4" Classes="Primary" Theme="{DynamicResource SolidButton}" />
                      <ContentControl Content="{Binding TecvizOzeti}" ContentTemplate="{StaticResource OzetSablonu}" />
                      <ItemsControl ItemsSource="{Binding TecvizMesajlari}" ItemTemplate="{StaticResource HataSablonu}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Panel>

              <!-- 3. DOP & Y1 dengeleme -->
              <Panel IsVisible="{Binding Wizard.IsStep3}">
                <StackPanel Spacing="10" DataContext="{Binding Hesap}" IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">
                  <Border Classes="kart">
                    <StackPanel Spacing="0">
                      <Border Classes="kartBaslik"><TextBlock Text="⚖️ DÜZENLEME ALANLARI" Classes="bolum" /></Border>
                      <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Text="R1 (Σ tapu)" Classes="aciklama" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding R1, Converter={x:Static g:Ceviriciler.Sayi}, ConverterParameter='0.00 m²'}" Classes="deger mono" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="R2 otomatik (Σ dengelenmiş imar)" Classes="aciklama" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding R2Otomatik, Converter={x:Static g:Ceviriciler.Sayi}, ConverterParameter='0.00 m²'}" Classes="deger mono" />
                      </Grid>
                      <StackPanel Classes="alanBaslik">
                        <TextBlock Text="R2 (boş: otomatik · Netcad DOP sayfası)" Classes="etiket" />
                        <Border Classes="istege"><TextBlock Text="İsteğe bağlı" /></Border>
                      </StackPanel>
                      <TextBox Text="{Binding R2Text}" Watermark="otomatik"
                               Classes.hatali="{Binding R2Hatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <Grid Classes="alanHatasi" ColumnDefinitions="Auto,*" IsVisible="{Binding R2Hatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
<TextBlock Text="⛔" FontSize="10" Margin="0,1,5,0" />
<SelectableTextBlock Grid.Column="1" Text="{Binding R2Hatasi}" Classes="hata" />
</Grid>
                      <Grid ColumnDefinitions="*,8,*">
                        <StackPanel>
                          <StackPanel Classes="alanBaslik">
                            <TextBlock Text="D1 (m²)" Classes="etiket" />
                            <Border Classes="istege"><TextBlock Text="İsteğe bağlı" /></Border>
                          </StackPanel>
                          <TextBox Text="{Binding D1Text}" Classes.hatali="{Binding D1Hatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <Grid Classes="alanHatasi" ColumnDefinitions="Auto,*" IsVisible="{Binding D1Hatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
<TextBlock Text="⛔" FontSize="10" Margin="0,1,5,0" />
<SelectableTextBlock Grid.Column="1" Text="{Binding D1Hatasi}" Classes="hata" />
</Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <StackPanel Classes="alanBaslik">
                            <TextBlock Text="D2 (m²)" Classes="etiket" />
                            <Border Classes="istege"><TextBlock Text="İsteğe bağlı" /></Border>
                          </StackPanel>
                          <TextBox Text="{Binding D2Text}" Classes.hatali="{Binding D2Hatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <Grid Classes="alanHatasi" ColumnDefinitions="Auto,*" IsVisible="{Binding D2Hatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
<TextBlock Text="⛔" FontSize="10" Margin="0,1,5,0" />
<SelectableTextBlock Grid.Column="1" Text="{Binding D2Hatasi}" Classes="hata" />
</Grid>
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="*,8,*">
                        <StackPanel>
                          <StackPanel Classes="alanBaslik">
                            <TextBlock Text="R3 (m²)" Classes="etiket" />
                            <Border Classes="istege"><TextBlock Text="İsteğe bağlı" /></Border>
                          </StackPanel>
                          <TextBox Text="{Binding R3Text}" Classes.hatali="{Binding R3Hatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <Grid Classes="alanHatasi" ColumnDefinitions="Auto,*" IsVisible="{Binding R3Hatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
<TextBlock Text="⛔" FontSize="10" Margin="0,1,5,0" />
<SelectableTextBlock Grid.Column="1" Text="{Binding R3Hatasi}" Classes="hata" />
</Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <StackPanel Classes="alanBaslik">
                            <TextBlock Text="Ortak katılım (m²)" Classes="etiket" />
                            <Border Classes="istege"><TextBlock Text="İsteğe bağlı" /></Border>
                          </StackPanel>
                          <TextBox Text="{Binding OrtakKatilimText}" Classes.hatali="{Binding OrtakKatilimHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <Grid Classes="alanHatasi" ColumnDefinitions="Auto,*" IsVisible="{Binding OrtakKatilimHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
<TextBlock Text="⛔" FontSize="10" Margin="0,1,5,0" />
<SelectableTextBlock Grid.Column="1" Text="{Binding OrtakKatilimHatasi}" Classes="hata" />
</Grid>
                        </StackPanel>
                      </Grid>
                      <Button Content="DOP'u Uygula" Command="{Binding DopUygulaCommand}" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center" Margin="0,10,0,0" Classes="Primary" Theme="{DynamicResource SolidButton}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="kart">
                    <StackPanel Spacing="4">
                      <Border Classes="kartBaslik"><TextBlock Text="📊 SONUÇ" Classes="bolum" /></Border>
                      <SelectableTextBlock Text="{Binding DengelemeOzeti}" Classes="aciklama" />
                      <ContentControl Content="{Binding DopOzeti}" ContentTemplate="{StaticResource OzetSablonu}" />
                      <ItemsControl ItemsSource="{Binding DopMesajlari}" ItemTemplate="{StaticResource HataSablonu}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Panel>

              <!-- 4. Hak eşleştirme & hisse (anonim malik kodları — KVKK) -->
              <Panel IsVisible="{Binding Wizard.IsStep4}">
                <StackPanel Spacing="10" DataContext="{Binding Hesap}" IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">
                  <!-- P7.3-B (SAHA-006): webtapu PDF → TAKBİS + Malik Rehberi; Yaklaşık Yer Krokisi → Kroki. Önizleme onaylanmadan kutular değişmez. -->
                  <Border Classes="kart">
                    <StackPanel Spacing="6">
                      <Border Classes="kartBaslik"><TextBlock Text="📥 İÇE AKTARIM" Classes="bolum" /></Border>
                      <TextBlock Text="Ad/soyad yalnız yerel Malik Rehberi'ne yazılır; hesap anonim malik kodlarıyla yapılır (KVKK)." Classes="aciklama" TextWrapping="Wrap" />
                      <Button x:Name="WebtapuYukleDugmesi" Content="📄 webtapu PDF Yükle" Command="{Binding WebtapuIsteCommand}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              ToolTip.Tip="webtapu 'Tapu Kaydı' PDF'lerini seçin (birden çok seçilebilir); yalnız TAKBİS hisselerini doldurur." />
                      <ItemsControl ItemsSource="{Binding WebtapuOnizlemeleri}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="kart" Margin="0,2">
                              <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                  <SelectableTextBlock Text="{Binding Baslik}" Classes="deger" TextWrapping="Wrap" />
                                  <Button Grid.Column="1" Content="✕" Padding="6,0" ToolTip.Tip="Bu önizlemeyi kaldır"
                                          Command="{Binding $parent[ItemsControl].DataContext.WebtapuOnizlemesiniKaldirCommand}"
                                          CommandParameter="{Binding}" />
                                </Grid>
                                <TextBlock Text="{Binding Konum}" Classes="aciklama" TextWrapping="Wrap"
                                           IsVisible="{Binding Konum, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <ItemsControl ItemsSource="{Binding MalikSatirlari}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <SelectableTextBlock Text="{Binding}" Classes="mono" FontSize="11" TextWrapping="Wrap" />
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                                  <TextBlock Text="Kadastro parseli" Classes="etiket" VerticalAlignment="Center" Margin="0,0,8,0" />
                                  <ComboBox Grid.Column="1" ItemsSource="{Binding KadastroSecenekleri}" SelectedItem="{Binding SeciliKadastroParsel}"
                                            HorizontalAlignment="Stretch" PlaceholderText="seçin" />
                                </Grid>
                                <SelectableTextBlock Text="{Binding Uyari}" Classes="hata" TextWrapping="Wrap"
                                                     IsVisible="{Binding Uyari, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button x:Name="TakbiseAktarDugmesi" Content="TAKBİS'e Aktar" Command="{Binding TakbiseAktarCommand}"
                              IsVisible="{Binding WebtapuOnizlemesiVar}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              Classes="Primary" Theme="{DynamicResource SolidButton}" />
                      <Button x:Name="KrokiNczYukleDugmesi" Content="📐 Yaklaşık Yer Krokisi (.NCZ) Yükle" Command="{Binding KrokiNczIsteCommand}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,0"
                              ToolTip.Tip="Malik kullanım alanları krokisi; TAKBİS hisseleri ve imar parselleriyle eşleştirilip Kroki satırları üretilir." />
                      <ContentControl Content="{Binding KrokiOzeti}" ContentTemplate="{StaticResource OzetSablonu}"
                                      IsVisible="{Binding KrokiOzeti, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <StackPanel Spacing="4" IsVisible="{Binding KrokiOnizlemesiVar}">
                        <TextBox Text="{Binding KrokiOnizlemesi, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MaxHeight="140"
                                 FontFamily="Consolas" FontSize="11" />
                        <ItemsControl ItemsSource="{Binding KrokiUyarilari}" ItemTemplate="{StaticResource UyariSablonu}" />
                        <Grid ColumnDefinitions="*,6,Auto">
                          <Button x:Name="KrokiyeAktarDugmesi" Content="Kroki'ye Aktar" Command="{Binding KrokiyeAktarCommand}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="Primary" Theme="{DynamicResource SolidButton}" />
                          <Button Grid.Column="2" Content="Vazgeç" Command="{Binding KrokiOnizlemesiniKaldirCommand}" />
                        </Grid>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Classes="kart">
                    <StackPanel Spacing="0">
                      <Border Classes="kartBaslik"><TextBlock Text="🧾 HAK EŞLEŞTİRME" Classes="bolum" /></Border>
                      <TextBlock Text="Malik kodları anonim olmalıdır (KVKK). Satır başına bir kayıt." Classes="aciklama" />
                      <StackPanel Classes="alanBaslik">
                        <TextBlock Text="TAKBİS hisseleri: parsel;malikKodu;pay/payda;E|H" Classes="etiket" TextWrapping="Wrap" />
                        <Border Classes="zorunlu"><TextBlock Text="Zorunlu" /></Border>
                      </StackPanel>
                      <TextBox Text="{Binding TakbisMetni}" AcceptsReturn="True" Height="90" FontFamily="Consolas"
                               Classes.hatali="{Binding TakbisHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <Grid Classes="alanHatasi" ColumnDefinitions="Auto,*" IsVisible="{Binding TakbisHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
<TextBlock Text="⛔" FontSize="10" Margin="0,1,5,0" />
<SelectableTextBlock Grid.Column="1" Text="{Binding TakbisHatasi}" Classes="hata" />
</Grid>
                      <StackPanel Classes="alanBaslik">
                        <TextBlock Text="Kroki: malikKodu;kadastroParsel;imarParselKodu;alan" Classes="etiket" TextWrapping="Wrap" />
                        <Border Classes="zorunlu"><TextBlock Text="Zorunlu" /></Border>
                      </StackPanel>
                      <TextBox Text="{Binding KrokiMetni}" AcceptsReturn="True" Height="110" FontFamily="Consolas"
                               Classes.hatali="{Binding KrokiHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <Grid Classes="alanHatasi" ColumnDefinitions="Auto,*" IsVisible="{Binding KrokiHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
<TextBlock Text="⛔" FontSize="10" Margin="0,1,5,0" />
<SelectableTextBlock Grid.Column="1" Text="{Binding KrokiHatasi}" Classes="hata" />
</Grid>
                      <StackPanel Classes="alanBaslik">
                        <TextBlock Text="Geçici ↔ tescil: geciciKod;tescilNo" Classes="etiket" />
                        <Border Classes="istege"><TextBlock Text="İsteğe bağlı" /></Border>
                      </StackPanel>
                      <TextBox Text="{Binding KimlikMetni}" AcceptsReturn="True" Height="60" FontFamily="Consolas"
                               Classes.hatali="{Binding KimlikHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <Grid Classes="alanHatasi" ColumnDefinitions="Auto,*" IsVisible="{Binding KimlikHatasi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
<TextBlock Text="⛔" FontSize="10" Margin="0,1,5,0" />
<SelectableTextBlock Grid.Column="1" Text="{Binding KimlikHatasi}" Classes="hata" />
</Grid>
                      <Button Content="Hak Eşleştirmeyi Uygula" Command="{Binding HakUygulaCommand}" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center" Margin="0,10,0,4" Classes="Primary" Theme="{DynamicResource SolidButton}" />
                      <ContentControl Content="{Binding HakOzeti}" ContentTemplate="{StaticResource OzetSablonu}" />
                      <TextBlock Text="Hisse dağıtım satırları alttaki 'Hak &amp; Hisse' sekmesindedir." Classes="aciklama" />
                      <ItemsControl ItemsSource="{Binding HakMesajlari}" ItemTemplate="{StaticResource HataSablonu}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Panel>

              <!-- 5. Onay & Çıktı: sağ paneldeki onay ekranı -->
              <StackPanel Spacing="10" IsVisible="{Binding Wizard.IsStep5}">
                <Border Classes="kart vurgu">
                  <StackPanel Spacing="4">
                    <Border Classes="kartBaslik"><TextBlock Text="✍️ ONAY &amp; ÇIKTI" Classes="bolum" /></Border>
                    <TextBlock Text="Sağ paneldeki onay ekranından güncel revizyonu onaylayın. Excel, Fen Klasörü ve CKS yalnızca güncel revizyonun geçerli onayıyla üretilir; veri değişirse onay kendiliğinden düşer."
                               Classes="aciklama" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <ContentControl Content="{Binding Hesap.DurumMetni}" ContentTemplate="{StaticResource OzetSablonu}" />
              <TextBlock Text="Proje çalışma alanı yok: 2–5. adımlar devre dışı." IsVisible="{Binding Hesap, Converter={x:Static ObjectConverters.IsNull}}"
                         Classes="aciklama" />
            </StackPanel>
          </ScrollViewer>

          <!-- Sabit alt cubuk: 1. adimda Girdileri Dogrula (kaydirmada yari gizlenmez) + Geri / Ileri -->
          <Border Grid.Row="2" Background="{DynamicResource CadPanel}" BorderBrush="{DynamicResource CadBorder}" BorderThickness="0,1,0,0" Padding="12,10" BoxShadow="0 -4 12 0 #22000000">
            <StackPanel Spacing="8">
            <Button x:Name="DogrulaDugmesi" Content="✔ Girdileri Doğrula" Click="OnValidateClick" HorizontalAlignment="Stretch" MinHeight="34"
                    HorizontalContentAlignment="Center" Classes="Primary" Theme="{DynamicResource SolidButton}"
                    IsVisible="{Binding Wizard.DogrulamaGorunur}" />
            <Grid ColumnDefinitions="*,8,*">
              <Button x:Name="GeriDugmesi" Content="◀ Geri" Command="{Binding Wizard.BackCommand}" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" MinHeight="34" />
              <Button x:Name="IleriDugmesi" Grid.Column="2" Content="İleri ▶" Command="{Binding Wizard.NextCommand}" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" MinHeight="34" Classes="Primary" Theme="{DynamicResource SolidButton}"
                      ToolTip.Tip="1. adımda ilerlemek için önce girdileri doğrulayın" />
            </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <GridSplitter x:Name="SolBolme" Grid.Column="1" Width="4" ResizeDirection="Columns" />

      <!-- ===================== ORTA: SkiaSharp 2B CAD tuvali + HUD + OSNAP ===================== -->
      <Grid Grid.Column="2" RowDefinitions="*,Auto">
        <Panel ClipToBounds="True">
          <c:CadCanvasControl x:Name="Tuval" ViewModel="{Binding Canvas}">
            <c:CadCanvasControl.ContextMenu>
              <ContextMenu ItemsSource="{Binding Canvas.ContextMenuItems}">
                <ContextMenu.Styles>
                  <Style Selector="MenuItem">
                    <Setter Property="Header" Value="{Binding Title}" />
                    <Setter Property="Command" Value="{Binding Command}" />
                    <Setter Property="ToolTip.Tip" Value="{Binding DisabledReason}" />
                    <!-- P7.3-A: "Bu Katmanın Rolü ▸" alt menüsü (yalnız alt öğesi olan menü öğesinde dolu) -->
                    <Setter Property="ItemsSource" Value="{Binding AltOgeler}" />
                  </Style>
                </ContextMenu.Styles>
              </ContextMenu>
            </c:CadCanvasControl.ContextMenu>
          </c:CadCanvasControl>

          <!-- Sol üst: role göre renk lejantı + Kadastro ↔ İmar perdesi -->
          <Border Classes="hud" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="■ Kadastro" Foreground="{DynamicResource CadAmber}" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Text="■ İmar" Foreground="{DynamicResource CadBlue}" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Text="■ Yol" Classes="genisDar" Foreground="{DynamicResource CadSlate}" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Text="■ Park" Classes="genisDar" Foreground="{DynamicResource CadEmerald}" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Text="■ Sınır" Classes="genisDar" Foreground="{DynamicResource CadRose}" FontSize="11" VerticalAlignment="Center" />
              <Border Width="1" Height="14" Background="{DynamicResource CadBorder}" VerticalAlignment="Center" />
              <TextBlock Text="Perde" Classes="aciklama" VerticalAlignment="Center" />
              <Slider Minimum="0" Maximum="100" Width="96" Value="{Binding Canvas.SwipePercent}" VerticalAlignment="Center"
                      ToolTip.Tip="Sola çekerek eski kadastro ile yeni imar durumunu karşılaştırın" />
              <TextBlock Text="{Binding Canvas.SwipePercent, StringFormat='%{0:0}'}" Classes="mono" VerticalAlignment="Center" MinWidth="34" />
            </StackPanel>
          </Border>

          <!-- Sağ üst: yakınlaştırma + Koyu/Açık Pafta (yalnız çizim) anahtarı -->
          <Border Classes="hud" Margin="12" Padding="4" HorizontalAlignment="Right" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="arac" Content="−" Command="{Binding Canvas.UzaklasCommand}" ToolTip.Tip="Uzaklaş" />
              <Button Classes="arac" Content="{Binding Canvas.ZoomText}" Command="{Binding FitAllCommand}" ToolTip.Tip="Tümünü sığdır (Ctrl+0)" />
              <Button Classes="arac" Content="+" Command="{Binding Canvas.YakinlasCommand}" ToolTip.Tip="Yakınlaş" />
              <Border Width="1" Height="18" Background="{DynamicResource CadBorder}" Margin="4,0" VerticalAlignment="Center" />
              <Button x:Name="PaftaAnahtari" Classes="arac" Content="{Binding PaftaEtiketi}" Command="{Binding PaftaDegistirCommand}"
                      ToolTip.Tip="Yalnız çizim paftasını koyu / açık (beyaz kağıt) yapar; stüdyo teması değişmez" />
            </StackPanel>
          </Border>

          <!-- Üst orta: P7.3-A tuvalden rol atama modu (aktif rol, imleçteki katman → hedef rol, Esc) -->
          <Border x:Name="RolAtamaHud" Classes="hud" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Top"
                  BorderBrush="{DynamicResource CadAmber}" IsHitTestVisible="False" IsVisible="{Binding Canvas.RolAtamaAktif}">
            <TextBlock Text="{Binding Canvas.RolAtamaMetni}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource CadAmber}" />
          </Border>

          <!-- Sol alt: şeffaf Türkçe HUD (seçili parsel + jeodezik imleç) -->
          <Border x:Name="TuvalHud" Classes="hud" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                  BorderBrush="{DynamicResource CadAccent}" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="16">
              <TextBlock Text="{Binding Canvas.SeciliOzet}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CadAmber}" />
              <TextBlock Text="{Binding Canvas.CursorText}" Classes="mono" Foreground="{DynamicResource CadMuted}" />
            </StackPanel>
          </Border>
        </Panel>

        <!-- Alt: OSNAP yakalama + görünüm araç çubuğu -->
        <Border x:Name="OsnapCubugu" Grid.Row="1" Classes="panel" BorderThickness="0,1,0,0" Padding="10,5">
          <WrapPanel>
            <TextBlock Text="YAKALAMA (OSNAP)" Classes="bolum" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ToggleButton Classes="osnap" Content="⬚ Uç" IsChecked="{Binding Canvas.OsnapUc}" Margin="0,0,4,0" ToolTip.Tip="Köşe / uç noktaya yakala (kare sembol)" />
            <ToggleButton Classes="osnap" Content="△ Orta" IsChecked="{Binding Canvas.OsnapOrta}" Margin="0,0,4,0" ToolTip.Tip="Kenar orta noktasına yakala (üçgen sembol)" />
            <ToggleButton Classes="osnap" Content="⊥ Dik 90°" IsChecked="{Binding Canvas.OsnapDik}" Margin="0,0,4,0" ToolTip.Tip="Kenara dik ayak noktasına yakala (dik açı sembolü)" />
            <ToggleButton Classes="osnap" Content="✕ Kesişim" IsChecked="{Binding Canvas.OsnapKesisim}" Margin="0,0,4,0" ToolTip.Tip="İki kenarın kesişimine yakala (çarpı halkası)" />
            <Border Width="1" Height="18" Background="{DynamicResource CadBorder}" Margin="8,0" VerticalAlignment="Center" />
            <TextBlock Text="GÖRÜNÜM" Classes="bolum" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ToggleButton Classes="osnap" Content="▦ Izgara" IsChecked="{Binding Canvas.IzgaraGoster}" Margin="0,0,4,0" />
            <ToggleButton Classes="osnap" Content="🏷 Etiketler" IsChecked="{Binding Canvas.EtiketGoster}" Margin="0,0,4,0" />
            <Border Width="1" Height="18" Background="{DynamicResource CadBorder}" Margin="8,0" VerticalAlignment="Center" />
            <SelectableTextBlock x:Name="SecilenNoktaMetni" Text="{Binding Canvas.SecilenNoktaMetni}" Classes="mono" Foreground="{DynamicResource CadCyan}"
                                 VerticalAlignment="Center" Margin="0,0,10,0"
                                 IsVisible="{Binding Canvas.SecilenNoktaMetni, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="Sol sürükle: kaydır · Tekerlek: yakınlaş · Çift tık: sığdır · OSNAP noktasına tık: seç + kopyala · Sağ tık: parsel işlemleri"
                       Classes="aciklama genis" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </WrapPanel>
        </Border>
      </Grid>

      <GridSplitter x:Name="SagBolme" Grid.Column="3" Width="4" ResizeDirection="Columns" />

      <!-- ===================== SAĞ: PARSEL DENETÇİSİ (bağlama göre) ===================== -->
      <Border x:Name="SagPanel" Grid.Column="4" Classes="panel" BorderThickness="1,0,0,0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10" Margin="12,12,20,12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="📐 PARSEL DENETÇİSİ" Classes="bolum" VerticalAlignment="Center" />
              <Border Grid.Column="1" Classes="rozet" IsVisible="{Binding Canvas.Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding Canvas.Selected.Label}" Classes="mono" Foreground="{DynamicResource CadBlue}" FontWeight="Bold" />
              </Border>
            </Grid>

            <!-- 1–4. adımlar: seçili parsel, gerçek parsel işlemleri, sade revizyon özeti -->
            <Panel x:Name="SagOzetModu" IsVisible="{Binding Wizard.SagPanelOzetModu}">
              <StackPanel Spacing="10">
                <Border Classes="kart">
                  <StackPanel Spacing="4">
                    <Border Classes="kartBaslik"><TextBlock Text="SEÇİLİ PARSEL" Classes="bolum" /></Border>
                    <TextBlock Text="Tuvalde bir parsele tıklayın (sağ tık: işlemler)." Classes="aciklama"
                               IsVisible="{Binding Canvas.Selected, Converter={x:Static ObjectConverters.IsNull}}" />
                    <StackPanel Spacing="3" IsVisible="{Binding Canvas.Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="Katman" Classes="aciklama" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Canvas.Selected.LayerName}" Classes="deger mono" TextTrimming="CharacterEllipsis" />
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="Rol" Classes="aciklama" />
                        <TextBlock Grid.Column="1" Text="{Binding Canvas.Selected.Role, Converter={x:Static g:TurkceAdConverter.Ornek}}" Classes="deger" />
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="Alan (Decimal Gauss)" Classes="aciklama" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Canvas.Selected.AreaM2, Converter={x:Static g:Ceviriciler.Sayi}, ConverterParameter='0.00 m²'}"
                                             Classes="deger mono" Foreground="{DynamicResource CadBlue}" />
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Classes="kart">
                  <StackPanel Spacing="4">
                    <Border Classes="kartBaslik"><TextBlock Text="{Binding Canvas.ContextMenuTitle}" Classes="bolum" /></Border>
                    <ItemsControl x:Name="ParselIslemleri" ItemsSource="{Binding Canvas.ParselIslemleri}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Content="{Binding Title}" Command="{Binding Command}" ToolTip.Tip="{Binding Title}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2">
                            <Button.ContentTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                              </DataTemplate>
                            </Button.ContentTemplate>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Diğer işlemler (köşe pahı, müşterek çözüm, cephe kilidi) sağ tık menüsünde; sonraki fazda bağlanacak."
                               Classes="aciklama" />
                  </StackPanel>
                </Border>

                <Border Classes="kart vurgu" IsVisible="{Binding Canvas.CutHandle.IsVisible}">
                  <StackPanel Spacing="4">
                    <TextBlock Text="✂️ CANLI KESİM TUTAMACI (ÖNİZLEME)" Classes="bolum" Foreground="{DynamicResource CadAmber}" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Kesim açısı (75°–105°)" Classes="etiket" />
                      <TextBlock Grid.Column="1" Text="{Binding Canvas.CutHandle.AngleDeg, Converter={x:Static g:Ceviriciler.Sayi}, ConverterParameter=0.0°}" Classes="deger mono" VerticalAlignment="Bottom" />
                    </Grid>
                    <Slider Minimum="75" Maximum="105" Value="{Binding Canvas.CutHandle.AngleDeg}" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Cephe boyunca konum (oran)" Classes="etiket" />
                      <TextBlock Grid.Column="1" Text="{Binding Canvas.CutHandle.PositionRatio, Converter={x:Static g:Ceviriciler.Sayi}, ConverterParameter=0.00}" Classes="deger mono" VerticalAlignment="Bottom" />
                    </Grid>
                    <Slider Minimum="0" Maximum="1" Value="{Binding Canvas.CutHandle.PositionRatio}" />
                  </StackPanel>
                </Border>

                <Border Classes="kart uyari" IsVisible="{Binding Warnings.Count, Converter={x:Static g:Ceviriciler.Pozitif}}" Padding="4">
                  <Expander Classes="bolum" IsExpanded="False" Header="{Binding Warnings.Count, StringFormat='⚠️ İçe Aktarma Uyarıları ({0})'}">
                    <ItemsControl ItemsSource="{Binding Warnings}" ItemTemplate="{StaticResource UyariSablonu}" />
                  </Expander>
                </Border>

                <Panel IsVisible="{Binding OnayCikti, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <Border Classes="kart" DataContext="{Binding OnayCikti}">
                    <StackPanel Spacing="3">
                      <Border Classes="kartBaslik"><TextBlock Text="📊 REVİZYON ÖZETİ" Classes="bolum" /></Border>
                      <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Text="Revizyon" Classes="aciklama" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                          <SelectableTextBlock Text="{Binding RevizyonKisa}" Classes="mono" ToolTip.Tip="{Binding RevizyonTam}" VerticalAlignment="Center" />
                          <Button Classes="kopyala" Content="⧉" Command="{Binding RevizyonuKopyalaCommand}" ToolTip.Tip="Panoya kopyala" />
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Parsel sayısı" Classes="aciklama" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Ekran.ParselSayisi}" Classes="deger mono" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Toplam kadastro alanı" Classes="aciklama" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Ekran.ToplamKadastroAlaniM2, Converter={x:Static g:Ceviriciler.Sayi}, ConverterParameter='0.00 m²'}" Classes="deger mono" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="DOPO" Classes="aciklama" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Ekran.Dopo, Converter={x:Static g:Ceviriciler.Sayi}, ConverterParameter=0.0000000}" Classes="deger mono" />
                      </Grid>
                      <TextBlock Text="Onay ve Excel / Fen Klasörü / CKS çıktıları 5. adımda (Onay &amp; Çıktı) gösterilir." Classes="aciklama" Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>
                </Panel>
              </StackPanel>
            </Panel>

            <!-- 5. adım: mühendis onayı ve taslak çıktılar -->
            <Panel x:Name="SagOnayModu" IsVisible="{Binding Wizard.SagPanelOnayModu}">
              <StackPanel Spacing="10">
                <TextBlock Text="Proje çalışma alanı yok: onay ve çıktı devre dışı." Classes="aciklama"
                           IsVisible="{Binding OnayCikti, Converter={x:Static ObjectConverters.IsNull}}" />
                <Panel IsVisible="{Binding OnayCikti, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <StackPanel Spacing="10" DataContext="{Binding OnayCikti}">
                    <Border Classes="kart hata" Padding="10,6">
                      <TextBlock Text="PİLOT — RESMÎ İŞLEMDE KULLANILAMAZ" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource CadRose}"
                                 HorizontalAlignment="Center" />
                    </Border>

                    <Border Classes="kart">
                      <StackPanel Spacing="3">
                        <Border Classes="kartBaslik"><TextBlock Text="🧾 ONAY EKRANI" Classes="bolum" /></Border>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                          <TextBlock Text="Revizyon" Classes="aciklama" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <SelectableTextBlock Text="{Binding RevizyonKisa}" Classes="mono" ToolTip.Tip="{Binding RevizyonTam}" VerticalAlignment="Center" />
                            <Button Classes="kopyala" Content="⧉" Command="{Binding RevizyonuKopyalaCommand}" ToolTip.Tip="Panoya kopyala" />
                          </StackPanel>
                        </Grid>
                        <DockPanel LastChildFill="True">
<TextBlock DockPanel.Dock="Right" Text="{Binding Ekran.ParselSayisi}" Classes="deger mono" Margin="8,0,0,0" />
<TextBlock Text="Parsel sayısı" Classes="aciklama" />
</DockPanel>
                        <DockPanel LastChildFill="True">
<TextBlock DockPanel.Dock="Right" Text="{Binding Ekran.ToplamKadastroAlaniM2, Converter={x:Static g:Ceviriciler.Sayi}, ConverterParameter='0.00 m²'}" Classes="deger mono" Margin="8,0,0,0" />
<TextBlock Text="Toplam kadastro alanı" Classes="aciklama" />
</DockPanel>
                        <DockPanel LastChildFill="True">
<TextBlock DockPanel.Dock="Right" Text="{Binding Ekran.Dopo, Converter={x:Static g:Ceviriciler.Sayi}, ConverterParameter=0.0000000}" Classes="deger mono" Margin="8,0,0,0" />
<TextBlock Text="DOPO" Classes="aciklama" />
</DockPanel>
                        <DockPanel LastChildFill="True">
<TextBlock DockPanel.Dock="Right" Text="{Binding Ekran.TecvizUyariSayisi}" Classes="deger mono" Margin="8,0,0,0" />
<TextBlock Text="Tecviz uyarısı" Classes="aciklama" />
</DockPanel>
                        <DockPanel LastChildFill="True">
<TextBlock DockPanel.Dock="Right" Text="{Binding Ekran.KritikHataSayisi}" Classes="deger mono" Margin="8,0,0,0" />
<TextBlock Text="Kritik hata" Classes="aciklama" />
</DockPanel>
                        <SelectableTextBlock Text="{Binding Ekran.MevzuatProfiliSurumu, StringFormat='Mevzuat profili: {0}'}" Classes="aciklama" Margin="0,4,0,0" />
                        <SelectableTextBlock Text="{Binding Ekran.ParsidSemaDurumu, StringFormat='PARSİD: {0}'}" Classes="aciklama" />
                      </StackPanel>
                    </Border>

                    <Border Classes="kart hata" IsVisible="{Binding EngelVar}">
                      <StackPanel Spacing="3">
                        <TextBlock Text="⛔ ONAY ENGELLERİ" Classes="bolum" Foreground="{DynamicResource CadRose}" />
                        <ItemsControl ItemsSource="{Binding Engeller}" ItemTemplate="{StaticResource HataSablonu}" />
                      </StackPanel>
                    </Border>

                    <Border Classes="kart uyari" IsVisible="{Binding TopolojiNotlari.Count, Converter={x:Static g:Ceviriciler.Pozitif}}">
                      <StackPanel Spacing="3">
                        <TextBlock Text="🧭 TOPOLOJİ DENETİMİ (parsel / m²)" Classes="bolum" Foreground="{DynamicResource CadAmber}" />
                        <ItemsControl ItemsSource="{Binding TopolojiNotlari}" ItemTemplate="{StaticResource TopolojiSablonu}" />
                      </StackPanel>
                    </Border>

                    <Border Classes="kart vurgu">
                      <StackPanel Spacing="6">
                        <Border Classes="kartBaslik"><TextBlock Text="✍️ MÜHENDİS ONAYI" Classes="bolum" /></Border>
                        <TextBlock Text="{Binding OnayMetni}" Classes="aciklama" />
                        <CheckBox Content="Onay metnini okudum ve kabul ediyorum" IsChecked="{Binding OnayMetniOkundu}" />
                        <Grid ColumnDefinitions="*,8,*">
                          <Button Content="Onayla" Command="{Binding OnaylaCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  Classes="Primary" Theme="{DynamicResource SolidButton}" />
                          <Button Grid.Column="2" Content="Onayı Geri Al" Command="{Binding GeriAlCommand}" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center" />
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border Classes="kart">
                      <StackPanel Spacing="6">
                        <Border Classes="kartBaslik"><TextBlock Text="📤 TASLAK ÇIKTILAR" Classes="bolum" /></Border>
                        <Button Content="📊 Excel Cetvelleri (.xlsx)" Command="{Binding CetvelIsteCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                        <Button Content="📗 Fen Klasörü (.pdf)" Command="{Binding FenKlasoruIsteCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                        <Button Content="🗂️ CKS DOP Özeti (.CKS)" Command="{Binding CksIsteCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                        <TextBlock Text="Yalnızca güncel revizyonun geçerli onayıyla üretilir; onaysız istek reddedilip denetime yazılır." Classes="aciklama" />
                        <ContentControl Content="{Binding DurumMetni}" ContentTemplate="{StaticResource OzetSablonu}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Panel>
              </StackPanel>
            </Panel>

            <StackPanel Spacing="1" Margin="2,4,0,0">
              <TextBlock Text="Alan hesabı: Yerel orijinli Decimal Gauss" Classes="aciklama" />
              <TextBlock Text="Hisse yuvarlama: Largest Remainder" Classes="aciklama" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <GridSplitter x:Name="AltBolme" Grid.Row="3" Height="4" ResizeDirection="Rows" HorizontalAlignment="Stretch" />

    <!-- ===================== ALT: 5 sekmeli canlı cetvel ===================== -->
    <Border x:Name="AltPanel" Grid.Row="4" Classes="panel" BorderThickness="0,1,0,0">
      <Grid RowDefinitions="Auto,*">
        <Border Background="{DynamicResource CadNav}" BorderBrush="{DynamicResource CadBorder}" BorderThickness="0,0,0,1" Padding="12,3">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock Text="📋" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock x:Name="CetvelBasligi" Grid.Column="1" Text="CANLI CETVEL • Tam Kesinlikli Hesap • cm² Hassasiyetli" FontWeight="Bold" FontSize="11"
                       Foreground="{DynamicResource CadBlue}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Parcels.Count, StringFormat='Σ kapalı poligon: {0}'}" Classes="mono"
                       Foreground="{DynamicResource CadEmerald}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Grid.Column="3" Classes="arac" Content="{Binding AltPanelEtiketi}" Command="{Binding AltPanelDegistirCommand}" />
          </Grid>
        </Border>

        <TabControl x:Name="AltSekmeler" Grid.Row="1" Padding="10,4">
          <TabItem Header="📋 Parseller">
            <Grid RowDefinitions="Auto,*">
              <Grid ColumnDefinitions="2.2*,1.5*,1.3*,1.6*" Margin="0,2,0,4">
                <TextBlock Text="Katman" Classes="etiket" />
                <TextBlock Grid.Column="1" Text="Rol" Classes="etiket" />
                <TextBlock Grid.Column="2" Text="Parsel No" Classes="etiket" />
                <TextBlock Grid.Column="3" Text="Alan (m², Decimal Gauss)" Classes="etiket" />
              </Grid>
              <ScrollViewer Grid.Row="1">
                <ItemsControl x:Name="ParselTablosu" ItemsSource="{Binding Parcels}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="2.2*,1.5*,1.3*,1.6*" Margin="0,1">
                        <SelectableTextBlock Text="{Binding LayerName}" Classes="mono" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Role}" Classes="aciklama" />
                        <SelectableTextBlock Grid.Column="2" Text="{Binding Label}" Classes="mono" Foreground="{DynamicResource CadAmber}" />
                        <SelectableTextBlock Grid.Column="3" Text="{Binding AreaM2, Converter={x:Static g:Ceviriciler.Sayi}, ConverterParameter='0.00 m²'}" Classes="mono" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </TabItem>

          <TabItem Header="📐 Tecviz">
            <Panel>
              <TextBlock Text="Proje çalışma alanı yok." Classes="aciklama" IsVisible="{Binding Hesap, Converter={x:Static ObjectConverters.IsNull}}" />
              <Grid RowDefinitions="Auto,Auto,*" DataContext="{Binding Hesap}" IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl Content="{Binding TecvizOzeti}" ContentTemplate="{StaticResource OzetSablonu}" Margin="0,2,0,4" />
                <Grid Grid.Row="1" ColumnDefinitions="2*,1.6*,2*" Margin="0,0,0,4">
                  <TextBlock Text="Kadastro parseli" Classes="etiket" />
                  <TextBlock Grid.Column="1" Text="Hesap alanı (m², Gauss)" Classes="etiket" />
                  <TextBlock Grid.Column="2" Text="Tapu alanı (m², mühendis)" Classes="etiket" />
                </Grid>
                <ScrollViewer Grid.Row="2">
                  <ItemsControl ItemsSource="{Binding TecvizSatirlari}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="2*,1.6*,2*" Margin="0,1">
                          <SelectableTextBlock Text="{Binding ParselId}" Classes="mono" />
                          <SelectableTextBlock Grid.Column="1" Text="{Binding HesapAlaniM2, Converter={x:Static g:Ceviriciler.Sayi}, ConverterParameter=0.00}" Classes="mono" />
                          <SelectableTextBlock Grid.Column="2" Text="{Binding TapuAlaniText}" Classes="mono" Foreground="{DynamicResource CadEmerald}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Panel>
          </TabItem>

          <TabItem Header="⚖️ DOP &amp; Y1">
            <Panel>
              <TextBlock Text="Proje çalışma alanı yok." Classes="aciklama" IsVisible="{Binding Hesap, Converter={x:Static ObjectConverters.IsNull}}" />
              <ScrollViewer DataContext="{Binding Hesap}" IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="3" Margin="0,2">
                  <Grid ColumnDefinitions="280,*">
                    <TextBlock Text="R1 (Σ tapu)" Classes="aciklama" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding R1, Converter={x:Static g:Ceviriciler.Sayi}, ConverterParameter='0.00 m²'}" Classes="mono" />
                  </Grid>
                  <Grid ColumnDefinitions="280,*">
                    <TextBlock Text="R2 otomatik (Σ dengelenmiş imar)" Classes="aciklama" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding R2Otomatik, Converter={x:Static g:Ceviriciler.Sayi}, ConverterParameter='0.00 m²'}" Classes="mono" />
                  </Grid>
                  <SelectableTextBlock Text="{Binding DengelemeOzeti}" Classes="mono" />
                  <ContentControl Content="{Binding DopOzeti}" ContentTemplate="{StaticResource OzetSablonu}" />
                  <ItemsControl ItemsSource="{Binding DopMesajlari}" ItemTemplate="{StaticResource UyariSablonu}" />
                </StackPanel>
              </ScrollViewer>
            </Panel>
          </TabItem>

          <TabItem Header="🧾 Hak &amp; Hisse">
            <Panel>
              <TextBlock Text="Proje çalışma alanı yok." Classes="aciklama" IsVisible="{Binding Hesap, Converter={x:Static ObjectConverters.IsNull}}" />
              <Grid RowDefinitions="Auto,*" DataContext="{Binding Hesap}" IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl Content="{Binding HakOzeti}" ContentTemplate="{StaticResource OzetSablonu}" Margin="0,2,0,4" />
                <ScrollViewer Grid.Row="1">
                  <ItemsControl ItemsSource="{Binding HakSatirlari}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                          <SelectableTextBlock Text="{Binding}" Classes="mono" TextWrapping="Wrap" />
                          <Button Grid.Column="1" Classes="kopyala" Content="⧉" Tag="{Binding}" Click="OnKopyalaClick" ToolTip.Tip="Panoya kopyala" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Panel>
          </TabItem>

          <TabItem Header="{Binding DenetimUyariSayisi, StringFormat='⚠️ Uyarı &amp; Denetim ({0})'}">
            <ScrollViewer>
              <StackPanel x:Name="DenetimPaneli" Spacing="4" Margin="0,2">
                <TextBlock Text="İÇE AKTARMA UYARILARI (hesabı / topolojiyi etkileyen)" Classes="bolum" />
                <TextBlock Text="Uyarı yok." Classes="aciklama" IsVisible="{Binding Warnings.Count, Converter={x:Static g:Ceviriciler.Sifir}}" />
                <ItemsControl x:Name="UyariListesi" ItemsSource="{Binding Warnings}" ItemTemplate="{StaticResource UyariSablonu}" />
                <StackPanel Spacing="4" IsVisible="{Binding OnayCikti.TopolojiNotlari.Count, Converter={x:Static g:Ceviriciler.Pozitif}, FallbackValue=False}">
                  <TextBlock Text="TOPOLOJİ DENETİMİ (parsel çifti / parsel · m²)" Classes="bolum" Margin="0,8,0,0" />
                  <ItemsControl ItemsSource="{Binding OnayCikti.TopolojiNotlari}" ItemTemplate="{StaticResource TopolojiSablonu}" />
                </StackPanel>
                <StackPanel Spacing="4" IsVisible="{Binding BilgiNotlari.Count, Converter={x:Static g:Ceviriciler.Pozitif}}">
                  <TextBlock Text="BİLGİ NOTLARI (rutin; uyarı sayısına girmez)" Classes="bolum" Margin="0,8,0,0" />
                  <ItemsControl x:Name="BilgiListesi" ItemsSource="{Binding BilgiNotlari}" ItemTemplate="{StaticResource BilgiSablonu}" />
                </StackPanel>
                <TextBlock Text="ONAY ÖN KOŞULLARI (5. adımda çözülür)" Classes="bolum" Margin="0,8,0,0"
                           IsVisible="{Binding OnayCikti, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ItemsControl ItemsSource="{Binding OnayCikti.Engeller}" ItemTemplate="{StaticResource UyariSablonu}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Grid>
    </Border>

    <!-- ===================== DURUM ÇUBUĞU ===================== -->
    <Border Grid.Row="5" Background="{DynamicResource CadCard}" BorderBrush="{DynamicResource CadBorder}" BorderThickness="0,1,0,0" Padding="12,4">
      <Grid ColumnDefinitions="*,Auto,200,Auto,Auto">
        <SelectableTextBlock x:Name="DurumMetni" Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1" Classes="kopyala" Content="⧉" Tag="{Binding StatusText}" Click="OnKopyalaClick" ToolTip.Tip="Durum metnini panoya kopyala" Margin="4,0" />
        <ProgressBar Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" IsVisible="{Binding IsBusy}" Margin="8,0" />
        <Button Grid.Column="3" Content="İptal" Command="{Binding CancelImportCommand}" IsVisible="{Binding IsBusy}" Margin="0,0,8,0" />
        <TextBlock Grid.Column="4" Text="PİLOT — RESMÎ İŞLEMDE KULLANILAMAZ" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource CadRose}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- ===================== Ctrl+K kural tabanlı komut çubuğu (dışarı tıklama / Esc kapatır) ===================== -->
    <Border x:Name="KomutKatmani" Grid.RowSpan="6" IsVisible="{Binding Palette.IsOpen}" Background="#99000000" PointerPressed="OnKomutKatmaniPointerPressed">
      <Border x:Name="KomutKutusu" Width="600" VerticalAlignment="Top" Margin="0,70,0,0" Background="{DynamicResource CadPanel}"
              BorderBrush="{DynamicResource CadAccent}" BorderThickness="1" CornerRadius="12" Padding="12" BoxShadow="0 12 32 0 #66000000">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="⌨️ Komut (Ctrl+K) — kural tabanlı, yapay zekâ içermez · ↑↓ seç · Tık / Enter çalıştır · Esc kapat" Classes="aciklama" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="kopyala" Content="✕" Command="{Binding Palette.KapatCommand}" ToolTip.Tip="Kapat (Esc)" />
          </Grid>
          <TextBox x:Name="PaletteInput" Text="{Binding Palette.Query}" Watermark="Komut yazın: 'sığdır', 'kadastro', 'pafta', 'onay', 'temizle'…" KeyDown="OnPaletteKeyDown" />
          <ListBox x:Name="KomutListesi" Classes="komutlar" ItemsSource="{Binding Palette.Results}" SelectedIndex="{Binding Palette.SelectedIndex}" MaxHeight="340"
                   Tapped="OnKomutListesiTapped" DoubleTapped="OnKomutListesiTapped">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <SelectableTextBlock Text="{Binding Palette.Mesaj}" Classes="ozet"
                               IsVisible="{Binding Palette.Mesaj, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
